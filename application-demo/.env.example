# Copy this file into .env file which should contain your production secrets.
# ── Storage ──────────────────────────────────────────────────────────────────
# Options: memory | disk | s3
LAMI_STORAGE_TYPE=s3

# S3 / MinIO credentials
LAMI_S3_ENDPOINT=http://minio:9000
LAMI_S3_ACCESS_KEY=minioadmin
LAMI_S3_SECRET_KEY=minioadmin
LAMI_S3_BUCKET=lamisema-vault

# ── MinIO (local/self-hosted only) ────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Webapp ───────────────────────────────────────────────────────────────────
# Internal docker network address of the API — do not change for local compose
API_URL=http://api:9001
